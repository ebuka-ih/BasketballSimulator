<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BasketballEngine.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Basketball.Controls"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="BasketballEngine.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BasketballEngine.Desktop"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#38342a">
        <StackPanel Orientation="Vertical">
                <Button Content="Games" 
                        Command="{Binding ShowGamePanelCommand}"/>
                <ContentControl Content="{Binding CurrentViewModel}"/>
        </StackPanel>
</Window>