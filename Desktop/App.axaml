<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BasketballEngine.Desktop.App"
             xmlns:local="using:BasketballEngine.Desktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    
    <Application.Resources>
        <FontFamily x:Key="BarlowBold">
            avares://BasketballEngine.Desktop/Assets/fonts/Barlow#Barlow
        </FontFamily>
        <Bitmap x:Key="CourtFloor">
            avares://BasketballEngine.Desktop/Assets/images/court.jpg
        </Bitmap>
    </Application.Resources>
</Application>